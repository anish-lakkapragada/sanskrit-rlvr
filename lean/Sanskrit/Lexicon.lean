# Lexicon (GENERATED — do not edit)

Generated by data/dcs/generate_lexicon.py from the Digital Corpus of
Sanskrit (DCS, Hellwig): the top lemmas by fragment-usable corpus
frequency — declined non-compound tokens for nominals, finite present
indicative (non-passive) tokens for verbs. Athematic verb paradigms are
curated tables validated against attested corpus cells; transitivity is
estimated from accusative co-occurrence. 500 nouns, 150 adjectives, 98 verbs, 24 indeclinables.
-/

namespace Sanskrit

structure NounEntry where
  stem  : String
  cls   : StemClass
  gloss : String
  pada  : String := ""   -- word-final base of a root stem (vāc → vāk)
  deriving Repr

inductive AdjClass
  | a         -- sundara: a-stem masc/neut, ā- or ī-feminine
  | pron      -- sarva: pronominal, neuter -am
  | pron_at   -- anya: pronominal, neuter -at
  | pron_opt  -- pūrva: pronominal and plain endings both classical
  | i | u     -- śuci, bahu
  | inn       -- balin, yogin-type
  | mat       -- bhagavat, mahat
  deriving DecidableEq, Repr

structure AdjEntry where
  stem    : String
  cls     : AdjClass
  femStem : String
  gloss   : String
  deriving Repr

structure VerbEntry where
  lemma : String
  stem  : String            -- thematic present stem; "" for athematic
  pada  : Pada
  trans : Bool              -- requires an accusative object
  gloss : String
  forms : AthematicTable := []
  deriving Repr

/-- The three (stem, class) paradigms an adjective declines in. -/
def AdjEntry.triples (e : AdjEntry) : List (String × StemClass) :=
  let femCls : StemClass :=
    if e.femStem.back == 'I' then .I_f
    else if e.femStem.back == 'A' then .A_f
    else if e.femStem.back == 'i' then .i_f else .u_f
  match e.cls with
  | .a        => [(e.stem, .a_m), (e.stem, .a_n), (e.femStem, femCls)]
  | .pron     => [(e.stem, .pron_m), (e.stem, .pron_n), (e.femStem, .pron_f)]
  | .pron_at  => [(e.stem, .pron_m), (e.stem, .pron_n_at), (e.femStem, .pron_f)]
  | .pron_opt => [(e.stem, .pron_opt_m), (e.stem, .pron_opt_n), (e.femStem, .pron_opt_f)]
  | .i        => [(e.stem, .i_m), (e.stem, .i_n), (e.femStem, femCls)]
  | .u        => [(e.stem, .u_m), (e.stem, .u_n), (e.femStem, femCls)]
  | .inn      => [(e.stem, .in_m), (e.stem, .in_n), (e.femStem, .I_f)]
  | .mat      => [(e.stem, .mat_m), (e.stem, .mat_n), (e.femStem, .I_f)]

/-- All present forms of a verb entry (a thematic form, or a table cell). -/
def VerbEntry.presentForms (e : VerbEntry) (p : Person) (n : Number) : List String :=
  if e.forms.isEmpty then [conjugate e.stem e.pada p n]
  else match athematicForm e.forms p n with
       | some f => [f]
       | none => []

private def N (stem : String) (cls : StemClass) (gloss : String)
    (pada : String := "") : NounEntry :=
  ⟨stem, cls, gloss, pada⟩

