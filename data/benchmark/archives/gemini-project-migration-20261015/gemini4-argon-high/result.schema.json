{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Gemini 4 Argon HIGH results (schema v2, prompts v3)",
  "description": "One array per family; one row per task, selecting the latest explicitly authorized settled attempt. All earlier attempts remain in the journals.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/result"
  },
  "$defs": {
    "result": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Join to the original benchmark row for inputs and accepted answers."
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "completed",
            "refused",
            "incomplete",
            "api_error",
            "transport_error",
            "unknown"
          ]
        },
        "output_text": {
          "type": "string",
          "description": "Unmodified visible response text, including any available partial text."
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "correct": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Exact membership in the source gold list for completed responses; null for other outcomes."
        },
        "format_ok": {
          "type": "boolean",
          "description": "One nonempty answer block; only whitespace outside; no nested markup."
        },
        "usage": {
          "type": [
            "object",
            "null"
          ],
          "description": "Full provider usage. Output length is usage.output_tokens; reasoning is its subset. Null when unavailable.",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens_details": {
              "type": "object",
              "additionalProperties": true
            },
            "output_tokens_details": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": true
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Gross usage-based estimate; null when unknown. Zero without usage only for confirmed non-200 responses or requests never sent."
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Null on normal success; otherwise compact error/refusal/incomplete or unknown-cost details, preserving provider codes/messages."
        }
      },
      "required": [
        "task_id",
        "attempt_number",
        "status",
        "output_text",
        "answer",
        "correct",
        "format_ok",
        "usage",
        "cost_usd",
        "request_id",
        "response_id",
        "elapsed_ms",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "correct": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "correct": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "cost_usd": {
                "enum": [
                  null,
                  0
                ]
              }
            }
          }
        }
      ]
    }
  }
}
