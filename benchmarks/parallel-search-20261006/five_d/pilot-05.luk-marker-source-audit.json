{
  "created_at": "2026-10-07T08:17:42.356585+00:00",
  "status": "Proposed conservative uncertainty predicates; coordinator independent review pending",
  "issue": "Possible prohibited transfer of original root-marker and gana membership effects after independent yaNluk",
  "primary_sources": [
    {
      "url": "https://sa.wikisource.org/wiki/शब्दकौस्तुभः/अध्यायः_१-पादः_१/आह्निकम्_४",
      "location": "Discussion of1.1.4; paribhasa131; lines112–114",
      "evidence": "Explicitly denies operations specified by root anubandha or gana in yaNluk; illustrates blocked din-yut and explains preservation of ordinary yaN effects separately."
    },
    {
      "url": "https://ashtadhyayi.com/nyaas/29?scroll=nyaas-74005",
      "location": "Nyasa7.4.5",
      "evidence": "Explicitly excludes yaNluk from the specially named tisthati vowel change even in a later causative aorist; this confirms that the paribhasa remains relevant after adding Ric."
    },
    {
      "url": "https://samsaadhanii-concordance.vipran.in/dhatu/1204-PaNaz-gawO-PaN1",
      "location": "Madhaviya/Dhatupatha Ghatadi mit appendices",
      "evidence": "Distinguishes listed Ghatadi roots from the broad am-final prescription. The latter can still describe a newly intensive-luk stem, so am-final cases are not included in the proposed non-am lexical gate."
    },
    {
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/7/7.4.2.htm",
      "location": "Three branches of shortening prohibition",
      "evidence": "aglopi, sas, and r-it are distinct grounds. A bare7.4.2 trace does not identify the r-it branch."
    }
  ],
  "proposed_predicates": [
    {
      "id": "r_it_shortening_block_after_luk",
      "predicate": "operations contain yaNluk before Ric AND trace7.4.2 AND original dictionary citation ends in f~ with optional accent markers",
      "reason": "Conservatively hold possible prohibited root-anubandha transfer; preserve sas/aglopi cases without r-it."
    },
    {
      "id": "non_am_lexical_mit_after_luk",
      "predicate": "operations contain yaNluk before Ric AND trace6.4.92 AND bare lexical base is not am-final",
      "reason": "Hold lexical/gana mit transfer. Do not blanket am-final stems, for which a separate phonological mit prescription exists."
    }
  ],
