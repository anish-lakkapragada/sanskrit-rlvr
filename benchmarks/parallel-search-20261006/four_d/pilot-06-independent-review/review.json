  "source_review": [
    {
      "rule": "3.4.92",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/3/3.4.92.htm",
      "review": "Kashika applies at augmentation and p-it status to first-person Lot. Nyasa assigns p-it to the ending, not the augment, and explicitly connects absence of ng-it to guna. Both padas are illustrated."
    },
    {
      "rule": "1.2.4",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/1/1.2.4.htm",
      "review": "A non-p-it sarvadhatuka is treated as ng-it. Nyasa explicitly warns that Lot p-it applies to the ending, not the intervening augment or class suffix."
    },
    {
      "rule": "1.1.5",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/1/1.1.5.htm",
      "review": "k/ng-conditioned guna/vrddhi prohibition is contextual; a rule ID anywhere in a trace does not identify which suffix conditions the root."
    },
    {
      "rule": "6.4.111",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/6/6.4.111.htm",
      "review": "Deletion of a in sna(m) and as requires a following k/ng-it sarvadhatuka; non-k/ng examples preserve a."
    },
    {
      "rule": "6.4.113",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/6/6.4.113.htm",
      "review": "Long i replaces sna/reduplicated a before consonant-initial k/ng-it sarvadhatuka, excluding ghu roots. Balamanorama directly contrasts mimi-vah/mah forms with Lot mima-vahai/mahai forms."
    },
    {
      "rule": "6.4.107",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/6/6.4.107.htm",
      "review": "Deletion of non-cluster-preceded suffix u before m/v is optional; both retained-u and deleted-u weak forms must remain accepted."
    },
    {
      "rule": "6.4.116",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/6/6.4.116.htm",
      "review": "Jahati has optional short-i alongside long-i before consonant-initial k/ng-it sarvadhatuka; both appear in the ha control."
    },
    {
      "rule": "3.1.82",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/3/3.1.82.htm",
      "review": "Stumbh/skumbh license both sna and snu. Sautra does not restrict these entries to this one formation. Mixed branch coverage is valid but prevents an every-answer 6.4.113 interpretation."
    },
    {
      "rule": "7.3.84",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/7/7.3.84.htm",
      "review": "Guna of a final ik before a sarvadhatuka/ardhadhatuka, subject to blocking conditions, explains the strengthened nu/u suffix."
    },
    {
      "rule": "7.3.86",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/7/7.3.86.htm",
      "review": "Light penultimate ik guna subject to the conditioning suffix explains lih→leh; root-vowel and class-suffix strengthening must be distinguished."
    },
    {
      "rule": "1.3.12",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/1/1.3.12.htm",
      "review": "Root markers restrict Atmanepada; Kartari is not synonymous with Parasmaipada."
    },
    {
      "rule": "1.3.72",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/1/1.3.72.htm",
      "review": "Svarita/ny-it roots take Atmanepada under agent-benefiting-result interpretation. With no such context specified, the task accepts any licensed form rather than choosing one hidden pada."
    },
    {
      "rule": "1.3.78",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/1/1.3.78.htm",
      "review": "Parasmaipada applies to the remaining Kartari contexts. Unspecified pada means a licensed union, not unrestricted replacement of all roots by either ending."
    },
    {
      "rule": "6.4.34",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/6/6.4.34.htm",
      "review": "Sas has a lexical and k/ng-it-conditioned i alternation; its singleton branch was excluded from this fixed panel, avoiding an unsupported general branch extrapolation."
    },
    {
      "rule": "7.3.92",
      "url": "https://sanskritdocuments.org/learning_tools/ashtadhyayi/vyakhya/7/7.3.92.htm",
      "review": "The trnah im augment additionally requires consonant-initial p-it; the printed Lot first-person forms lack im. Thus p-it alone is not a universal rule that the entire word matches its present strong stem."
    }
  ],
